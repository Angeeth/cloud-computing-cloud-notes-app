# Cloud Notes App - Microservice 1 (Web Service) Environment Variables

# Port on which the web application listens (default: 3000)
PORT=3000

# The single Google Cloud Storage bucket used by the entire application
BUCKET_NAME=your-gcp-cloud-notes-bucket-name

# URL pointing to Microservice 2 (Upload Service)
# For local testing: http://localhost:8080
# For GCP Compute Engine: http://<VM2_INTERNAL_IP>:8080
UPLOAD_SERVICE_URL=http://localhost:8080

# Secret key used to authenticate requests to Microservice 2 (Matches INTERNAL_API_KEY in Microservice 2)
INTERNAL_API_KEY=replace-with-a-secure-random-token-here

# Optional: Set to 'true' ONLY for local offline testing without GCP credentials
# MOCK_STORAGE=false
